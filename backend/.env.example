# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/focushub

# Supabase project URL  (used to derive the JWKS endpoint for JWT verification)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key  (only needed for admin-level Supabase operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port the HTTP server listens on (default: 8080)
PORT=8080
